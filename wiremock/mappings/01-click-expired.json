{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/conversions",
    "bodyPatterns": [
      { "matchesJsonPath": { "expression": "$.click_id", "matches": "^clk_old.*" } }
    ]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "error": "click_expired" }
  }
}
