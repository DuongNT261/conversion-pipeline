{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/v1/conversions",
    "headers": { "Idempotency-Key": { "matches": ".+" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"conversion_id\":\"cv_{{jsonPath request.body '$.order_id'}}\"}",
    "transformers": ["response-template"]
  }
}
